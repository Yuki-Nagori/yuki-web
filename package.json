{
  "name": "yuki-web",
  "version": "1.0.0",
  "private": true,
  "author": "Yuki",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "analyze": "bun run type-check && vite build --mode analyze",
    "check": "bun run lint && bun run format:check && bun run type-check && bun run test && bun run knip",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "knip": "^5",
    "prettier": "^3",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "5.0.3",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.11"
  }
}
