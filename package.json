{
  "name": "yuki-web",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Yuki",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=1.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/tsconfig": "^0.9.0",
    "@vueuse/core": "^14.3.0",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.1",
    "sitemap": "^9.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.32",
    "vue-eslint-parser": "^10.0.0",
    "zod": "^4.4.3"
  },
  "resolutions": {
    "lodash-es": "4.18.1",
    "esbuild": "0.25.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:dev:full": "yarn lint:fix && yarn format && vitepress dev docs",
    "docs:build": "yarn type-check && yarn test && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,md,json,yml}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  }
}
